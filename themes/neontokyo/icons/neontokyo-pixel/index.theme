[Icon Theme]
Name=Neon Tokyo Pixel
Comment=Ícones pixel neon do tema Neon Tokyo (fallback: Breeze Dark)
Inherits=breeze-dark,breeze,hicolor
# os ícones herdados do Breeze têm estilo ColorScheme-Text: sem isto ficam escuros em apps com esquema Sumi
FollowsColorScheme=true
Example=folder
DisplayDepth=32
Directories=apps/scalable,places/scalable

[apps/scalable]
Size=16
MinSize=8
MaxSize=512
Type=Scalable
Context=Applications

[places/scalable]
Size=16
MinSize=8
MaxSize=512
Type=Scalable
Context=Places
